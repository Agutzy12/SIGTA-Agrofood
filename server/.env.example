# Copiá este archivo como server/.env y ajustá los valores.
# Conexión a PostgreSQL (con Docker: npm run db:up)
DATABASE_URL="postgresql://sigta:sigta@localhost:5432/sigta?schema=public"
# Base para las pruebas automáticas
DATABASE_URL_TEST="postgresql://sigta:sigta@localhost:5432/sigta_test?schema=public"
# Clave para firmar las sesiones (en producción usá una larga y secreta)
JWT_SECRET="cambiar-esta-clave-en-produccion"
# Modo demo: muestra los accesos rápidos y las herramientas de datos de ejemplo
DEMO_MODE=true
TZ=America/Argentina/Cordoba
PORT=3000
# Conexión directa (para migraciones). En tu PC es la misma que DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://sigta:sigta@localhost:5432/sigta?schema=public"
