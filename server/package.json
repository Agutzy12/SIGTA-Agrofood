{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "description": "API REST de SIGTA (Express + TypeScript + Prisma + PostgreSQL)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrar.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env src/seed/cli.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed:si-vacia": "node --env-file-if-exists=.env dist/seed/cli.js --si-vacia"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
